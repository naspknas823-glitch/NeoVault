<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) backup / transfer policy.

  ⛔ SECURITY (§8.3): NeoVault stores the user's savings ledger in a
  SQLCipher-encrypted Drift database whose passphrase lives ONLY in the
  Android Keystore. A backup or device-to-device transfer would copy the
  encrypted vault to a device where that Keystore entry does not exist
  (unrecoverable data) and would move financial data off-device without
  consent — so BOTH channels are fully excluded.

  `android:allowBackup="false"` already disables cloud backup on every API
  level; these rules additionally cover Android 12+ device-to-device transfer,
  which `allowBackup` does not control.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
